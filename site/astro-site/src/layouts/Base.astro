---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';

import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import BotaoFlutuante from '../components/BotaoFlutuante.astro';
import { CONTATO, SITE, RASTREIO } from '../consts';

interface Props {
  titulo: string;
  descricao: string;
  /** Sobrescreve o <title>. Por padrão o título vem sufixado com a marca. */
  tituloCompleto?: string;
  /** Structured data extra da página (FAQ, Article, Breadcrumb). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { titulo, descricao, tituloCompleto, schema, noindex = false } = Astro.props;

const title = tituloCompleto ?? `${titulo} | ${SITE.nome}, advogado criminalista no RJ`;
const canonica = new URL(Astro.url.pathname, Astro.site ?? SITE.url);

/**
 * Perfil do escritório. Repetido em toda página de propósito — é assim que
 * buscador e assistente de IA associam o nome ao serviço e à cidade.
 */
const perfil = {
  '@context': 'https://schema.org',
  '@type': 'Attorney',
  name: `${SITE.assinatura} | ${SITE.nome}`,
  description: SITE.descricao,
  url: SITE.url,
  identifier: SITE.oab,
  telephone: `+${CONTATO.whatsappNumero}`,
  email: CONTATO.email,
  areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rio de Janeiro',
    addressRegion: 'RJ',
    addressCountry: 'BR',
  },
  knowsLanguage: 'pt-BR',
  sameAs: [CONTATO.instagramUrl],
  knowsAbout: [
    'Direito Criminal',
    'Prisão em flagrante',
    'Audiência de custódia',
    'Inquérito policial',
    'Execução penal',
    'Direito Empresarial',
  ],
};

const blocos = [perfil, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ id: RASTREIO.gtm }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', id);
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#05070A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.assinatura} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Orientação | Kovaleski Advogados" href="/rss.xml" />

    {
      blocos.map((bloco) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(bloco)} />
      ))
    }
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${RASTREIO.gtm}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <BotaoFlutuante />

    <script>
      /*
       * Motor de revelação do site. Um observador só, e cada alvo sai da
       * observação depois de aparecer — nada fica rodando durante a rolagem.
       */
      const alvos = document.querySelectorAll<HTMLElement>(
        '[data-revelar], [data-revelar-lista]'
      );

      if (alvos.length) {
        const parado = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Índice de cada filho, para o escalonamento em CSS.
        alvos.forEach((alvo) => {
          if (!alvo.hasAttribute('data-revelar-lista')) return;
          Array.from(alvo.children).forEach((filho, i) => {
            (filho as HTMLElement).style.setProperty('--i', String(i));
          });
        });

        if (parado) {
          alvos.forEach((alvo) => alvo.classList.add('visivel'));
        } else {
          alvos.forEach((alvo) => alvo.classList.add('armado'));

          const observador = new IntersectionObserver(
            (entradas) => {
              entradas.forEach((entrada) => {
                if (!entrada.isIntersecting) return;
                entrada.target.classList.add('visivel');
                observador.unobserve(entrada.target);
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
          );

          alvos.forEach((alvo) => observador.observe(alvo));
        }
      }
    </script>

    <script>
      /*
       * Desvio de conversão pelo WhatsApp. O wa.me tira a pessoa do site,
       * então não tem como saber se o clique virou contato de verdade. A
       * saída é abrir o WhatsApp numa aba nova e levar a aba original para
       * a página de obrigado pouco depois — é lá que mora o evento de
       * conversão do Google Ads.
       *
       * Sem JavaScript, ou na própria /obrigado/, o botão continua um link
       * normal para o WhatsApp: nada aqui depende do desvio pra funcionar.
       */
      if (location.pathname !== '/obrigado/') {
        const botoesWhatsapp = document.querySelectorAll<HTMLAnchorElement>(
          '[data-whatsapp-cta]'
        );

        botoesWhatsapp.forEach((botao) => {
          botao.addEventListener('click', (evento) => {
            evento.preventDefault();
            window.open(botao.href, '_blank', 'noopener,noreferrer');
            window.setTimeout(() => {
              window.location.href = '/obrigado/';
            }, 1200);
          });
        });
      }
    </script>
  </body>
</html>
