---
/**
 * Assinatura tipográfica usada no lugar do logo — ver `identidade/design-guide.md`.
 * Enquanto não existir arquivo de logo, é isso que marca as peças.
 *
 * Marca o escritório (Kovaleski Advogados), não a pessoa: é a leitura de
 * "escritório" que o negócio quer passar, não "advogado autônomo".
 * O nome do Douglas continua em `SITE.nome`, usado em título de página e
 * no schema.org, onde a autoridade pessoal ainda importa.
 */
import { SITE } from '../consts';

interface Props {
  tamanho?: 'pequena' | 'media';
}

const { tamanho = 'media' } = Astro.props;
---

<span class:list={['assinatura', tamanho]}>
  <span class="nome">{SITE.assinatura}</span>
  <span class="area">Advocacia Criminal e Empresarial</span>
</span>

<style>
  .assinatura {
    display: inline-flex;
    flex-direction: column;
    gap: 0.28em;
    font-family: var(--serifa-titulo);
    text-transform: uppercase;
    line-height: 1;
  }

  .nome {
    color: var(--texto);
    letter-spacing: 0.14em;
  }

  .area {
    color: var(--dourado);
    letter-spacing: 0.2em;
  }

  .media .nome {
    font-size: var(--txt-apoio);
  }

  .media .area {
    font-size: var(--txt-nano);
  }

  .pequena .nome {
    font-size: var(--txt-pequeno);
  }

  .pequena .area {
    font-size: var(--txt-nano);
  }
</style>
