---
import Assinatura from './Assinatura.astro';
import BotaoWhatsapp from './BotaoWhatsapp.astro';

const links = [
  { href: '/situacoes/', texto: 'Situações' },
  { href: '/blog/', texto: 'Orientação' },
  { href: '/sobre/', texto: 'Sobre' },
  { href: '/perguntas-frequentes/', texto: 'Dúvidas' },
  { href: '/canais-oficiais/', texto: 'Canais oficiais' },
];

const atual = Astro.url.pathname;
---

<header>
  <div class="container barra">
    <a href="/" class="marca" aria-label="Início">
      <Assinatura />
    </a>

    <input type="checkbox" id="menu-toggle" class="oculto-visual" />
    <label for="menu-toggle" class="hamburguer">
      <span aria-hidden="true"></span>
      <span class="oculto-visual">Abrir menu</span>
    </label>

    <nav aria-label="Principal">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={atual.startsWith(link.href) ? 'page' : undefined}
              >
                {link.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <BotaoWhatsapp texto="WhatsApp" class="cta-topo" />
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--dourado-tenue);
    background: rgba(5, 7, 10, 0.86);
    backdrop-filter: blur(10px);
  }

  .barra {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .marca {
    text-decoration: none;
    flex-shrink: 0;
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--serifa-titulo);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--dourado-claro);
    border-bottom-color: var(--dourado);
  }

  .hamburguer {
    display: none;
  }

  /* :global porque a classe é aplicada ao <a> renderizado por BotaoWhatsapp,
     que fica fora do escopo de estilo deste componente. */
  @media (max-width: 980px) {
    :global(.cta-topo) {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .barra {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .hamburguer {
      display: block;
      margin-left: auto;
      padding: 0.6rem;
      border: 1px solid var(--dourado-fraco);
      border-radius: 8px;
      cursor: pointer;
    }

    .hamburguer span[aria-hidden] {
      display: block;
      width: 20px;
      height: 1px;
      background: var(--dourado-claro);
      box-shadow: 0 6px 0 var(--dourado-claro), 0 -6px 0 var(--dourado-claro);
    }

    nav {
      flex-basis: 100%;
      margin-left: 0;
      display: none;
    }

    #menu-toggle:checked ~ nav {
      display: block;
    }

    nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding-bottom: 0.75rem;
    }

    nav a {
      font-size: 0.8rem;
      padding-block: 0.5rem;
    }
  }
</style>
