---
import { Image } from 'astro:assets';
import heroFoto from '../assets/hero.webp';
import Base from '../layouts/Base.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import { PREVENCAO, CONFLITO, PASSOS, PERGUNTAS } from '../data/empresarial';
import { SITE } from '../consts';

const MENSAGEM =
  'Olá, doutor. Tenho uma empresa e gostaria de falar sobre acompanhamento jurídico.';

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Início',
        item: new URL('/', Astro.site ?? SITE.url).href,
      },
      { '@type': 'ListItem', position: 2, name: 'Empresarial' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: PERGUNTAS.map((p) => ({
      '@type': 'Question',
      name: p.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: p.resposta },
    })),
  },
];
---

<Base
  titulo="Advocacia empresarial"
  tituloCompleto={`Advogado empresarial no Rio de Janeiro | ${SITE.nome}`}
  descricao="Advocacia empresarial preventiva no Rio de Janeiro: contratos, societário, trabalhista, LGPD, compliance, cobrança e defesa em processos. Atendimento direto com o advogado."
  schema={schema}
>
  <section class="hero fundo-topo">
    <div class="container">
      <div class="hero-grade">
        <div class="hero-texto">
          <p class="olho">Empresarial</p>
          <h1>Advocacia empresarial <span class="dourado">preventiva</span></h1>
          <hr class="divisor esquerda" />

          <p class="apoio">
            Boa parte do que vira processo passou antes por uma decisão tomada
            sem apoio jurídico: um contrato assinado do jeito que veio, um sócio
            que saiu no combinado verbal, uma demissão feita no improviso.
          </p>

          <p class="apoio">
            O trabalho aqui começa nesse ponto, antes do problema existir. E
            segue até o processo, quando ele vem mesmo assim.
          </p>

          <div class="botoes topo-acao">
            <BotaoWhatsapp
              texto="Falar sobre a empresa"
              variante="solido"
              mensagem={MENSAGEM}
            />
            <a class="botao botao--discreto" href="#prevencao">Ver o que inclui</a>
          </div>
        </div>

        <div class="hero-figura">
          <Image
            class="retrato"
            src={heroFoto}
            alt="Douglas Kovaleski, advogado, de terno e braços cruzados, com a balança da justiça ao fundo"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 85vw, (max-width: 1120px) 44vw, 490px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container medida prosa" data-revelar>
      <h2>Apoio contínuo, não serviço avulso</h2>
      <hr class="divisor esquerda" />

      <p>
        A empresa que só chama advogado quando recebe uma citação já perdeu as
        escolhas mais baratas. Nesse ponto o contrato está assinado, a rescisão
        está feita e a conversa passa a ser sobre prejuízo, não sobre prevenção.
      </p>

      <p>
        A proposta é o contrário disso: um jurídico disponível no dia a dia, para
        a empresa que não tem departamento interno e não precisa ter.
        <strong>
          Quem responde é o advogado que conduz o caso</strong>, sem central de
        atendimento e sem intermediário.
      </p>

      <p>
        Nada disso é garantia contra litígio, e nenhum advogado sério promete
        isso. O que muda é a posição da empresa quando o conflito chega: com
        documento em ordem, com o combinado no papel e com quem conhece a
        operação já dentro do assunto.
      </p>
    </div>
  </section>

  <section class="secao topo-zero" id="prevencao">
    <div class="container">
      <div class="centro" data-revelar>
        <p class="olho">Antes do problema</p>
        <h2>Manter a empresa organizada</h2>
        <hr class="divisor" />
        <p class="apoio medida">
          Cada frente tem um momento em que deixa de ser opcional. É esse
          momento que está marcado em cada cartão.
        </p>
      </div>

      <div class="grade" data-revelar-lista>
        {
          PREVENCAO.map((s) => (
            <article class="cartao">
              <span class="relogio">{s.momento}</span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao" id="conflito">
    <div class="container">
      <div class="centro" data-revelar>
        <p class="olho">Quando o problema aparece</p>
        <h2>Representar a empresa</h2>
        <hr class="divisor" />
        <p class="apoio medida">
          Prevenção reduz risco, não elimina. Quando o conflito vem, a
          representação é feita por quem já conhece a operação por dentro.
        </p>
      </div>

      <div class="grade" data-revelar-lista>
        {
          CONFLITO.map((s) => (
            <article class="cartao">
              <span class="relogio">{s.momento}</span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao" id="como-comeca">
    <div class="container">
      <div class="centro" data-revelar>
        <p class="olho">Como começa</p>
        <h2>Do diagnóstico ao acompanhamento</h2>
        <hr class="divisor" />
      </div>

      <ol class="etapas" data-revelar-lista>
        {
          PASSOS.map((passo) => (
            <li>
              <span class="numero">{passo.numero}</span>
              <h3>{passo.titulo}</h3>
              <p>{passo.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao" id="duvidas">
    <div class="container medida">
      <h2>Perguntas frequentes</h2>
      <hr class="divisor esquerda" />
      <div class="faq">
        {
          PERGUNTAS.map((p) => (
            <details>
              <summary>{p.pergunta}</summary>
              <p>{p.resposta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ChamadaFinal
    titulo="Vamos olhar a sua operação"
    texto="Me conte no WhatsApp o que a sua empresa faz e onde hoje aperta. A partir daí eu explico como o acompanhamento funcionaria no seu caso."
    mensagem={MENSAGEM}
  />
</Base>

<style>
  /*
   * Hero em duas colunas. A home usa três (texto, retrato, card + CTA) porque
   * carrega o selo de canais oficiais; aqui não há selo, então o retrato fica
   * com a coluna inteira da direita.
   */
  .hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--dourado-tenue);
    /* Contém o halo da figura, que se espalha além da coluna de propósito. */
    overflow: hidden;
  }

  .hero-grade {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    column-gap: clamp(1rem, 3vw, 2.5rem);
  }

  /* Sem `.medida`: dentro da grade quem trava a leitura é a própria coluna,
     e 68ch aqui sobraria para fora dela. */
  .hero-texto {
    position: relative;
    z-index: 1;
    max-width: 56ch;
  }

  .hero-texto h1 {
    margin-bottom: 0;
  }

  .topo-acao {
    margin-top: 2rem;
  }

  /*
   * Retrato. Segunda aparição do tratamento: transborda a coluna, dissolve na
   * base por máscara e ganha halo por gradiente. Se aparecer uma terceira,
   * vira componente, como já aconteceu com `.etapas` e `.faq`.
   */
  .hero-figura {
    position: relative;
    align-self: end;
    z-index: 0;
    width: 118%;
    margin-inline: -9%;
    animation: heroFoto 1.1s cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }

  /* Halo por gradiente e não por sombra: o design-guide veda sombra. */
  .hero-figura::before {
    content: '';
    position: absolute;
    inset: 8% -6% -2%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(22, 48, 77, 0.95) 0%,
      rgba(14, 32, 54, 0.5) 45%,
      transparent 70%
    );
  }

  /* Máscara e não faixa sobreposta: assim a base funde com o gradiente que
     estiver atrás, sem precisar acertar a cor exata daquela altura. */
  .retrato {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.55) 86%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.55) 86%,
      transparent 100%
    );
  }

  .hero-texto > * {
    animation: heroEntra 0.75s cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }

  .hero-texto > :nth-child(1) {
    animation-delay: 0.08s;
  }
  .hero-texto > :nth-child(2) {
    animation-delay: 0.16s;
  }
  .hero-texto > :nth-child(3) {
    animation-delay: 0.22s;
  }
  .hero-texto > :nth-child(4) {
    animation-delay: 0.28s;
  }
  .hero-texto > :nth-child(5) {
    animation-delay: 0.34s;
  }
  .hero-texto > :nth-child(6) {
    animation-delay: 0.4s;
  }

  /* Celular: foto primeiro, como na home, e o texto centraliza sob ela. */
  @media (max-width: 860px) {
    .hero-grade {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: 1.5rem;
    }

    .hero-figura {
      order: -1;
      width: 100%;
      max-width: 20rem;
      margin-inline: 0;
      margin-bottom: -0.5rem;
    }

    .hero-texto {
      text-align: center;
    }

    .hero-texto .divisor.esquerda {
      margin-inline: auto;
    }

    .hero-texto .botoes {
      justify-content: center;
    }
  }

  /* O bloco de texto encosta na seção de cima: os dois são a mesma ideia. */
  .topo-zero {
    padding-top: 0;
  }

  .prosa h2 {
    margin-top: 0;
  }
</style>
