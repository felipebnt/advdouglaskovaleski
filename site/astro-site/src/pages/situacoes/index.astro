---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';

const situacoes = (await getCollection('situacoes')).sort(
  (a, b) => a.data.ordem - b.data.ordem
);
---

<Base
  titulo="Situações"
  descricao="Prisão em flagrante, intimação para depor, inquérito, processo criminal, medida protetiva, execução penal e ato infracional. Entenda cada situação e o que fazer."
>
  <section class="secao fundo-topo">
    <div class="container centro">
      <p class="olho">Situações</p>
      <h1>Onde o seu caso está</h1>
      <hr class="divisor" />
      <p class="apoio medida">
        Cada momento tem prazo e caminho próprios. Encontre o que mais se parece
        com a sua situação. As páginas explicam o que acontece a seguir e o que
        evitar enquanto isso.
      </p>
    </div>
  </section>

  <section class="secao lista">
    <div class="container">
      <div class="grade">
        {
          situacoes.map((s) => (
            <a class="cartao" href={`/situacoes/${s.id}/`}>
              <span class="relogio">{s.data.relogio}</span>
              <h3>{s.data.titulo}</h3>
              <p>{s.data.resumo}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ChamadaFinal />
</Base>

<style>
  .lista {
    padding-top: 0;
  }

</style>
