---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BotaoWhatsapp from '../../components/BotaoWhatsapp.astro';
import ChamadaFinal from '../../components/ChamadaFinal.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const situacoes = await getCollection('situacoes');
  return situacoes.map((situacao) => ({
    params: { slug: situacao.id },
    props: { situacao },
  }));
}

interface Props {
  situacao: CollectionEntry<'situacoes'>;
}

const { situacao } = Astro.props;
const { data } = situacao;
const { Content } = await render(situacao);

/** Artigos do blog marcados com esta situação — link cruzado. */
const relacionados = (
  await getCollection(
    'blog',
    ({ data: b }) => !b.draft && b.situacao === situacao.id
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Início',
        item: new URL('/', Astro.site ?? SITE.url).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Situações',
        item: new URL('/situacoes/', Astro.site ?? SITE.url).href,
      },
      { '@type': 'ListItem', position: 3, name: data.titulo },
    ],
  },
];

if (data.perguntas.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.perguntas.map((p) => ({
      '@type': 'Question',
      name: p.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: p.resposta },
    })),
  });
}
---

<Base titulo={data.titulo} descricao={data.descricao} schema={schema}>
  <article>
    <header class="topo fundo-topo">
      <div class="container medida">
        <nav class="migalhas" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/situacoes/">Situações</a>
        </nav>
        <span class="relogio">{data.relogio}</span>
        <h1>{data.titulo}</h1>
        <hr class="divisor esquerda" />
        <p class="apoio">{data.resumo}</p>
        <div class="botoes">
          <BotaoWhatsapp mensagem={data.mensagemWhatsapp} />
        </div>
      </div>
    </header>

    <div class="container medida prosa">
      <Content />
    </div>

    {
      data.perguntas.length > 0 && (
        <section class="secao">
          <div class="container medida">
            <h2>Perguntas frequentes</h2>
            <hr class="divisor esquerda" />
            <div class="faq">
              {data.perguntas.map((p) => (
                <details>
                  <summary>{p.pergunta}</summary>
                  <p>{p.resposta}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      relacionados.length > 0 && (
        <section class="secao">
          <div class="container medida">
            <h2>Leia também</h2>
            <hr class="divisor esquerda" />
            <ul class="relacionados">
              {relacionados.map((artigo) => (
                <li>
                  <a href={`/blog/${artigo.id}/`}>{artigo.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>

  <ChamadaFinal mensagem={data.mensagemWhatsapp} />
</Base>

<style>
  .topo {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }

  .migalhas {
    font-family: var(--serifa-titulo);
    font-size: var(--txt-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-fraco);
    margin-bottom: 1.25rem;
    display: flex;
    gap: 0.6rem;
  }

  .migalhas a {
    color: var(--texto-fraco);
    text-decoration: none;
  }

  .migalhas a:hover {
    color: var(--dourado-claro);
  }

  .topo .botoes {
    margin-top: 1.75rem;
  }

  .relacionados {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .relacionados a {
    color: var(--texto-suave);
    text-decoration: none;
  }

  .relacionados a:hover {
    color: var(--dourado-claro);
  }
</style>
