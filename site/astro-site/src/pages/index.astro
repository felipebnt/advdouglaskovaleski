---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import heroFoto from '../assets/hero.webp';
import Base from '../layouts/Base.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import ChamadaFinal from '../components/ChamadaFinal.astro';
import LinhaDoTempo from '../components/LinhaDoTempo.astro';
import { ETAPAS, SITE } from '../consts';

const situacoes = (await getCollection('situacoes')).sort(
  (a, b) => a.data.ordem - b.data.ordem
);

const artigos = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<Base
  titulo="Advogado Criminalista no Rio de Janeiro"
  tituloCompleto={`${SITE.nome} | Advogado Criminalista no Rio de Janeiro`}
  descricao={SITE.descricao}
>
  <section class="hero fundo-topo">
    <div class="container">
      <div class="hero-grade">
        <p class="pilula">Advocacia criminal • {SITE.oab}</p>

        <h1>Defesa criminal <span class="dourado">desde a primeira hora</span></h1>

        <p class="apoio">
          A condução inicial de um caso criminal influencia todo o resto. Quando
          a orientação técnica chega cedo, a defesa começa no lugar certo, e não
          depois que o estrago já está no papel.
        </p>

        <div class="hero-figura">
          <Image
            class="retrato"
            src={heroFoto}
            alt="Douglas Kovaleski, advogado criminalista, de terno e braços cruzados, com a balança da justiça ao fundo"
            widths={[420, 640, 900]}
            sizes="(max-width: 980px) 78vw, 38vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <a class="selo" href="/canais-oficiais/">
          <span class="selo-marca" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <span>
            <strong>Canais oficiais</strong>
            Confirme antes de enviar informação ou fazer qualquer pagamento.
          </span>
        </a>

        <div class="botoes acao">
          <BotaoWhatsapp texto="Falar no WhatsApp" variante="solido" />
          <a class="botao botao--discreto" href="#situacoes">Ver situações</a>
        </div>
      </div>
    </div>
  </section>

  <LinhaDoTempo />

  <section class="secao" id="situacoes">
    <div class="container">
      <div class="centro" data-revelar>
        <p class="olho">Por onde você chegou aqui</p>
        <h2>Em que situação você está</h2>
        <hr class="divisor" />
        <p class="apoio medida">
          Cada uma dessas situações tem prazo e caminho próprios. Escolha a que
          mais se parece com a sua e entenda o que acontece a seguir.
        </p>
      </div>

      <div class="grade" data-revelar-lista>
        {
          situacoes.map((s) => (
            <a class="cartao" href={`/situacoes/${s.id}/`}>
              <span class="relogio">{s.data.relogio}</span>
              <h3>{s.data.chamada}</h3>
              <p>{s.data.resumo}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao" id="processo">
    <div class="container">
      <div class="centro" data-revelar>
        <p class="olho">Como funciona</p>
        <h2>Do primeiro contato ao acompanhamento</h2>
        <hr class="divisor" />
      </div>

      <ol class="etapas" data-revelar-lista>
        {
          ETAPAS.map((etapa) => (
            <li>
              <span class="numero">{etapa.numero}</span>
              <h3>{etapa.titulo}</h3>
              <p>{etapa.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="secao" id="sobre">
    <div class="container">
      <div class="sobre" data-revelar-lista>
        <div>
          <p class="olho">Quem atende</p>
          <h2>Douglas Kovaleski</h2>
          <hr class="divisor esquerda" />
          <p>
            Advogado atuante em direito criminal e empresarial no Rio de Janeiro.
            Quem fala com o escritório fala comigo. Não há intermediário entre o
            cliente e quem conduz o caso.
          </p>
          <p>
            O trabalho começa antes do processo: na delegacia, na custódia, no
            inquérito. É nesse período que a pessoa costuma decidir sozinha, com
            medo e sem informação, aquilo que vai pesar até o fim.
          </p>
          <p>
            Nenhum resultado é prometido aqui. Isso a ética da advocacia veda, e
            com razão. O que existe é condução técnica, sigilo e clareza sobre o
            que está acontecendo no seu caso.
          </p>
          <div class="botoes">
            <a class="botao botao--discreto" href="/sobre/">Conhecer o trabalho</a>
          </div>
        </div>

        <aside class="cartao areas">
          <h3>Áreas de atuação</h3>
          <ul>
            <li>Prisão em flagrante e audiência de custódia</li>
            <li>Habeas corpus, prisão ilegal e excesso de prazo</li>
            <li>Atendimento em delegacia, com ou sem intimação</li>
            <li>Inquérito policial e acompanhamento de depoimento</li>
            <li>Defesa em processo criminal e recursos</li>
            <li>Medidas protetivas e cautelares</li>
            <li>Execução penal, progressão e livramento</li>
            <li>Ato infracional (ECA e DEGASE)</li>
            <li>
              <a href="/empresarial/">Assessoria jurídica preventiva a empresas</a>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {
    artigos.length > 0 && (
      <section class="secao" id="orientacao">
        <div class="container">
          <div class="centro" data-revelar>
            <p class="olho">Orientação</p>
            <h2>Publicações recentes</h2>
            <hr class="divisor" />
            <p class="apoio medida">
              Conteúdo para entender o que está acontecendo. Não substitui a
              análise do seu caso concreto.
            </p>
          </div>

          <div class="grade" data-revelar-lista>
            {artigos.map((artigo) => (
              <a class="cartao" href={`/blog/${artigo.id}/`}>
                <time datetime={artigo.data.publishedAt.toISOString()}>
                  {artigo.data.publishedAt.toLocaleDateString('pt-BR', {
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric',
                  })}
                </time>
                <h3>{artigo.data.title}</h3>
                <p>{artigo.data.description}</p>
              </a>
            ))}
          </div>

          <div class="botoes centro ver-mais">
            <a class="botao botao--discreto" href="/blog/">
              Ver todas as publicações
            </a>
          </div>
        </div>
      </section>
    )
  }

  <ChamadaFinal
    titulo="Conte o que está acontecendo"
    texto="Descreva a situação no WhatsApp. Eu analiso o cenário e explico os próximos passos, com sigilo."
  />
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(3.5rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--dourado-tenue);
    /* Contém o halo da figura, que se espalha além da coluna de propósito. */
    overflow: hidden;
  }

  /*
   * Três colunas como na referência: texto à esquerda, retrato ao centro,
   * card + CTA à direita. As áreas nomeadas existem para o celular poder
   * reordenar (foto → selo → título → texto → CTA) sem duplicar markup.
   */
  .hero-grade {
    display: grid;
    grid-template-columns: 1.26fr 0.98fr 0.88fr;
    grid-template-areas:
      'pilula figura selo'
      'titulo figura selo'
      'texto  figura acao';
    align-items: center;
    /* Vão menor que o padrão: a coluna do meio precisa da folga para o retrato
       crescer, e a da direita para o botão caber numa linha só. */
    column-gap: clamp(1rem, 2.2vw, 2rem);
    row-gap: 0;
  }

  .pilula {
    grid-area: pilula;
  }
  .hero-grade h1 {
    grid-area: titulo;
  }
  .hero-grade > .apoio {
    grid-area: texto;
  }
  .hero-figura {
    grid-area: figura;
  }
  .selo {
    grid-area: selo;
    align-self: end;
  }
  .acao {
    grid-area: acao;
    align-self: start;
  }

  /* Pílula de contexto: mesma linguagem dos botões, em escala menor. */
  .pilula {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--dourado-fraco);
    border-radius: 999px;
    font-family: var(--serifa-titulo);
    font-size: var(--txt-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dourado);
  }

  /*
   * O h1 do hero dispensa o filete: o eixo de prazos é a régua da seção.
   * Corpo menor que o padrão global — numa coluna de três, o tamanho cheio
   * quebrava o título em cinco linhas. É o papel "Display compacto" do
   * DESIGN.md, não um valor solto, e vale só neste hero.
   */
  .hero h1 {
    font-size: clamp(1.7rem, 2.7vw, 2.4rem);
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .hero-grade > .apoio {
    max-width: 42ch;
    margin-bottom: 0;
  }

  .acao {
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /*
   * O retrato transborda a própria coluna para ganhar presença, como na
   * referência. Fica atrás do texto — o `overflow: hidden` do hero apara
   * o que passa da seção.
   */
  .hero-figura {
    position: relative;
    align-self: end;
    z-index: 0;
    width: 122%;
    margin-inline: -11%;
  }

  .pilula,
  .hero-grade h1,
  .hero-grade > .apoio,
  .selo,
  .acao {
    position: relative;
    z-index: 1;
  }

  /*
   * Entrada do hero. Os `@keyframes` moram no global.css; aqui fica só a
   * ordem, que é decisão desta página.
   *
   * A cascata coloca o CTA cedo. O botão do cabeçalho e o flutuante ficam de
   * fora dela: quem chega com pressa tem sempre um caminho imediato para o
   * WhatsApp, sem esperar animação nenhuma.
   */
  .hero-figura {
    animation: heroFoto 1.1s cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }

  .pilula,
  .hero-grade h1,
  .hero-grade > .apoio,
  .acao,
  .selo {
    animation: heroEntra 0.75s cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }

  .pilula {
    animation-delay: 0.1s;
  }
  .hero-grade h1 {
    animation-delay: 0.18s;
  }
  .hero-grade > .apoio {
    animation-delay: 0.28s;
  }
  .acao {
    animation-delay: 0.36s;
  }
  .selo {
    animation-delay: 0.48s;
  }

  /*
   * Halo atrás do recorte, para a figura não flutuar solta no fundo.
   * É gradiente, não sombra — o design-guide veda sombra.
   */
  .hero-figura::before {
    content: '';
    position: absolute;
    inset: 8% -6% -2%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(22, 48, 77, 0.95) 0%,
      rgba(14, 32, 54, 0.5) 45%,
      transparent 70%
    );
  }

  /*
   * A base do recorte se dissolve no fundo em vez de cortar seco.
   * Máscara e não faixa sobreposta: assim funde com o gradiente que
   * estiver atrás, sem precisar acertar a cor exata daquela altura.
   */
  .retrato {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.55) 86%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 68%,
      rgba(0, 0, 0, 0.55) 86%,
      transparent 100%
    );
  }

  .selo {
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--dourado-fraco);
    border-radius: var(--raio);
    /* Sem backdrop-filter: sobre fundo quase opaco ele não muda nada, e é
       fonte conhecida de falha de composição na rolagem em celular — o card
       vira um bloco sólido sem conteúdo. */
    background: rgba(9, 16, 28, 0.94);
    text-decoration: none;
    color: var(--texto-suave);
    font-size: var(--txt-nota);
    line-height: 1.4;
    transition: border-color 0.25s ease;
  }

  .selo:hover,
  .selo:focus-visible {
    border-color: var(--dourado);
  }

  .selo strong {
    display: block;
    margin-bottom: 0.15rem;
    font-family: var(--serifa-titulo);
    font-size: var(--txt-micro);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto);
  }

  .selo-marca {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid var(--dourado-fraco);
    border-radius: 50%;
    color: var(--dourado);
  }

  /* Tablet: o card e o CTA descem para baixo do texto, retrato ao lado. */
  @media (max-width: 1100px) and (min-width: 861px) {
    .hero-grade {
      grid-template-columns: 1fr 0.95fr;
      grid-template-areas:
        'pilula figura'
        'titulo figura'
        'texto  figura'
        'selo   figura'
        'acao   figura';
      row-gap: 1.25rem;
    }

    .selo,
    .acao {
      align-self: start;
    }
  }

  /* Celular: a ordem do mockup — foto, selo, título, texto, CTA. */
  @media (max-width: 860px) {
    .hero-grade {
      grid-template-columns: 1fr;
      /* O card desce para depois do CTA: entre a foto e o título ele cortava
         o hero ao meio e lia como uma barra solta. */
      grid-template-areas:
        'figura'
        'pilula'
        'titulo'
        'texto'
        'acao'
        'selo';
      row-gap: 1.5rem;
      justify-items: center;
      text-align: center;
    }

    .hero-figura {
      max-width: 20rem;
      margin-bottom: -0.5rem;
    }

    .hero-grade h1,
    .hero-grade > .apoio {
      margin-bottom: 0;
    }

    .selo {
      max-width: 22rem;
      text-align: left;
    }

    .acao {
      width: 100%;
      max-width: 22rem;
      margin-top: 0;
    }
  }

  .sobre {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.35fr 1fr;
    align-items: start;
  }

  .areas ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    color: var(--texto-suave);
    font-size: var(--txt-apoio);
  }

  .areas li {
    padding-left: 1.1rem;
    position: relative;
  }

  /* Só um item da lista é link (o empresarial, que tem página própria).
     Herda a cor da lista para não virar o destaque do cartão; o sublinhado
     no hover é que revela que ali se clica. */
  .areas a {
    color: inherit;
    text-decoration: none;
  }

  .areas a:hover,
  .areas a:focus-visible {
    color: var(--dourado-claro);
    text-decoration: underline;
  }

  .areas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 6px;
    height: 1px;
    background: var(--dourado);
  }

  .cartao time {
    display: block;
    font-family: var(--serifa-titulo);
    font-size: var(--txt-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dourado);
    margin-bottom: 0.75rem;
  }

  .ver-mais {
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .sobre {
      grid-template-columns: 1fr;
    }
  }
</style>
